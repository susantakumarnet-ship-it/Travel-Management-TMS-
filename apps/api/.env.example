# ── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (CORS + links in notifications)
APP_URL=http://localhost:3000
# Public URL of this API (used to build file URLs when STORAGE_DRIVER=local)
API_URL=http://localhost:4000
# MongoDB Atlas connection string (Database → Connect → Drivers). Include the database name.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/royal_ride?retryWrites=true&w=majority"

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# DEV ONLY: when set and NODE_ENV!=production, this OTP is accepted for every number
DEV_FIXED_OTP=123456

# ── SMS (MSG91) ─ leave blank to log messages to the console ──
SMS_DRIVER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=RYLRDE
MSG91_FLOW_TEMPLATE_ID=

# ── WhatsApp Business Cloud API ──────────────────────
WHATSAPP_DRIVER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
# Public number for the floating "chat with us" button (digits incl. country code)
WHATSAPP_PUBLIC_NUMBER=919000000000

# ── Email (SMTP) ─────────────────────────────────────
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Royal Ride <bookings@example.com>"

# ── Payments ─────────────────────────────────────────
# razorpay | cashfree
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# DEV ONLY: allow the built-in test gateway when no gateway keys are configured.
# Never enabled in production (the server refuses to start).
ALLOW_TEST_GATEWAY=true

# ── Storage ──────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Maps ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Company (invoices) ───────────────────────────────
COMPANY_NAME=Royal Ride Travels Pvt. Ltd.
COMPANY_GSTIN=21AAAAA0000A1Z5
COMPANY_STATE=Odisha
COMPANY_ADDRESS=Plot 42, Saheed Nagar, Bhubaneswar, Odisha 751007
COMPANY_PHONE=+91 90000 00000
COMPANY_EMAIL=hello@royalride.example

# ── Seed ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@royalride.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_PHONE=9000000001

# DEV/TEST ONLY: turns off rate limits for automated test runs (refused in production)
DISABLE_RATE_LIMITS=false
