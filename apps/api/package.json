{
  "name": "@royal-ride/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "npm run db:push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx --env-file=.env prisma/mongo-indexes.ts",
    "db:push": "prisma db push --skip-generate && tsx --env-file=.env prisma/mongo-indexes.ts",
    "db:indexes": "tsx --env-file=.env prisma/mongo-indexes.ts",
    "test:e2e": "node tests-e2e/e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.888.0",
    "@aws-sdk/s3-request-presigner": "3.888.0",
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "node-cron": "4.2.1",
    "nodemailer": "7.0.6",
    "pdfkit": "0.17.2",
    "pino": "9.9.5",
    "pino-http": "10.5.0",
    "razorpay": "2.9.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/express-serve-static-core": "5.0.7",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "24.5.2",
    "@types/nodemailer": "7.0.1",
    "@types/pdfkit": "0.17.3",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.1.1",
    "prisma": "6.16.2",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
