# Copy to deploy/.env.production and fill in. Never commit the real file.
# MongoDB Atlas (allow your server IP under Network Access)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/royal_ride?retryWrites=true&w=majority

APP_URL=https://royalride.example
API_URL=https://royalride.example
PORT=4000

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

SMS_DRIVER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_FLOW_TEMPLATE_ID=
MSG91_SENDER_ID=RYLRDE

WHATSAPP_DRIVER=cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_PUBLIC_NUMBER=

EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Royal Ride <bookings@royalride.example>"

PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
ALLOW_TEST_GATEWAY=false

STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

GOOGLE_MAPS_API_KEY=

COMPANY_NAME=Royal Ride Travels Pvt. Ltd.
COMPANY_GSTIN=
COMPANY_STATE=Odisha
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
